# Web build-time settings
# Leave API disabled for the hosted local-first demo. Set both values for sync/auth.
VITE_API_ENABLED=false
VITE_API_URL=https://api.example.com/v1
VITE_TELEGRAM_BOT_USERNAME=wego_bot

# API runtime settings (keep these on the API host, never in Vercel client env)
NODE_ENV=production
PORT=8787
HOST=0.0.0.0
DATABASE_URL=postgresql://user:password@host:5432/wego
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_BOT_USERNAME=wego_bot
TELEGRAM_WEBHOOK_SECRET=replace-me
NOTE_ENCRYPTION_KEY=base64-encoded-32-byte-key
WEB_ORIGIN=https://your-project.vercel.app
